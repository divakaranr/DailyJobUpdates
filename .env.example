# ---------------------------------------------------------------------------
# Docker Compose environment (copy to .env). For local dev see apps/api/.env.example.
# ---------------------------------------------------------------------------

# REQUIRED in production: long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
POSTGRES_PASSWORD=jobportal
PUBLIC_URL=http://localhost:3000
# Set to true when served over HTTPS
COOKIE_SECURE=false

# First super admin (created by the seed script)
SEED_ADMIN_EMAIL=admin@jobportal.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# LLM providers — set any you use. Without keys, the rule-based extractor is used.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional overrides (otherwise chosen automatically from configured keys)
LLM_PROVIDER=
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
