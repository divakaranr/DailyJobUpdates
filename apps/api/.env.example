# ---- Core ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# `pnpm db:local` starts PostgreSQL on 5433 without Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/jobportal
# Used by `pnpm test` for DB integration tests (database is migrated automatically)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/jobportal_test
# Optional — enables durable BullMQ queue; without it extractions run in-process
REDIS_URL=

# ---- Auth & security ----
# Required in production (>= 32 chars)
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
# Origins allowed to make state-changing requests (CSRF check)
APP_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT_PER_MIN=10
EXTRACTION_RATE_LIMIT_PER_MIN=20

# ---- LLM providers (keys never reach the browser) ----
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Optional: force a provider/model; otherwise picked from configured keys (Gemini → OpenAI → Groq → rule-based)
LLM_PROVIDER=
LLM_MODEL=
LLM_FALLBACK_PROVIDER=

# ---- URL fetching ----
FETCH_USER_AGENT=DailyJobUpdatesBot/1.0 (+job aggregation; respects robots.txt)
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=3000000
FETCH_MAX_REDIRECTS=5
FETCH_RETRIES=2
FETCH_HOST_INTERVAL_MS=1000
ENABLE_BROWSER_RENDERING=true
BROWSER_TIMEOUT_MS=25000
# TEST ONLY: lets E2E tests fetch a localhost fixture server. Rejected when NODE_ENV=production.
ALLOW_LOOPBACK_FETCH=false

# ---- Workers & scheduling ----
RUN_WORKER_IN_PROCESS=true
EXTRACTION_CONCURRENCY=2
MAINTENANCE_INTERVAL_MS=300000

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@jobportal.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_SAMPLE_DATA=true
